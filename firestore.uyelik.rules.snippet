// Canlı rules (isg-pusulasi) — 2026-08-24
// - Başvuru: herkes create; okuma/silme kapalı (admin SDK / ayrı yol)
// - Tanıtım indirme + fiyat kartları: herkes okuyabilir (yazma girişli)
// - Geri kalan: yalnız giriş yapmış hesap

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /uyelik_basvurulari/{id} {
      allow create: if request.resource.data.keys().hasAll([
        'adSoyad', 'email', 'telefon', 'sehir', 'mesaj', 'platform', 'createdAt', 'kaynak'
      ])
      && request.resource.data.kaynak == 'tanitim_web'
      && request.resource.data.email is string
      && request.resource.data.adSoyad is string;
      allow read, update, delete: if false;
    }

    match /sistem_ayarlari/indirme_paketleri {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sistem_ayarlari/fiyatlandirma_paketleri {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
